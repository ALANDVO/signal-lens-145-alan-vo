# Signal Lens Environment Variables

# App
APP_NAME=signal-lens
APP_VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./signal_lens.db

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=signal-lens
KEYCLOAK_CLIENT_ID=signal-lens-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback

# Session
SESSION_SECRET_KEY=change-me-in-production-use-secure-random
SESSION_COOKIE_NAME=signal_lens_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Frontend
FRONTEND_URL=http://localhost:5173

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=30.0

# Redis (optional, for production session storage)
REDIS_URL=